# VIVA AI — modelo de variáveis de ambiente.
# Copie para ".env.local" (desenvolvimento) ou cadastre no painel da hospedagem (produção).
# NUNCA coloque valores reais neste arquivo: ele vai para o repositório.

# ── Endereço público do app ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (banco, login e arquivos) — obrigatório ───────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SÓ no servidor. Dá acesso total ao banco. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── IA — sem isso o app mostra "configuração pendente", nunca resposta falsa ─
# Provedor: "anthropic" (padrão quando há ANTHROPIC_API_KEY) ou "openai-compat".
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo padrão (opcional; padrão: claude-haiku-4-5-20251001) e modelo dos planos pagos (opcional).
AI_MODEL_PADRAO=
AI_MODEL_AVANCADO=
# Só para provedor compatível com a API da OpenAI:
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
# Teto de gasto diário com IA, em dólar. Ao atingir, a IA pausa até o dia seguinte (UTC).
AI_ORCAMENTO_DIARIO_USD=
# Preço por milhão de tokens de modelos que o app não conhece (para o painel de custo):
# AI_PRECOS_JSON={"nome-do-modelo":{"entrada":0.5,"saida":1.5}}
AI_PRECOS_JSON=

# ── Pagamentos (Stripe) — opcional; sem isso os planos pagos ficam indisponíveis ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_FAMILIA=

# ── Dados da empresa exibidos em Termos e Privacidade ──────────────────────
NEXT_PUBLIC_EMPRESA_NOME=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_CONTATO_EMAIL=

# ── Somente desenvolvimento e testes (ignorado em produção) ────────────────
# IA simulada, claramente rotulada na tela: AI_PROVIDER=simulada + a linha abaixo.
# VIVA_PERMITIR_IA_SIMULADA=1
